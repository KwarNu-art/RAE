#import <UIKit/UIKit.h>
#import <QuartzCore/QuartzCore.h>
#import <objc/runtime.h>
#import <malloc/malloc.h>
#import <sys/resource.h>
#import <os/proc.h>
#import "Config.h"
#if RAE_HOOK_MTKVIEW
#import <MetalKit/MetalKit.h>
#endif

#ifndef PRIO_DARWIN_PROCESS
#define PRIO_DARWIN_PROCESS 4
#endif
#ifndef PRIO_DARWIN_BG
#define PRIO_DARWIN_BG 0x1000
#endif

static NSHashTable *gLinks;        // live display links and metal views (weak)
static NSInteger gThermalCap;      // 0 = no cap, otherwise the highest frame rate allowed while the phone is hot
static char kRequestedFPS;
static char kRequestedRange;

#pragma mark - Frame rate

static NSInteger RAEDisplayMax(void) {
    NSInteger max = UIScreen.mainScreen.maximumFramesPerSecond;
    return max > 0 ? max : 60;
}

// Applies the profile to a requested frame rate (0 means "as fast as the display allows").
static NSInteger RAEAdjustFPS(NSInteger requested) {
#if RAE_FPS_MODE == 1 || RAE_FPS_MODE == 2 || RAE_THERMAL_GUARD
    NSInteger maxFPS = RAEDisplayMax();
#endif
    NSInteger fps = requested;
#if RAE_FPS_MODE == 1
    // Smooth: when the app asks for less than the display can do, give it the display's full rate.
    if (requested > 0 && requested < maxFPS) fps = maxFPS;
#elif RAE_FPS_MODE == 2
    // Cool: never above 60 fps, even on 120 Hz screens.
    if (maxFPS > 60 && (requested == 0 || requested > 60)) fps = 60;
#endif
    if (gThermalCap > 0 && (fps == 0 || fps > gThermalCap)) fps = gThermalCap;
    return fps;
}

static CAFrameRateRange RAEAdjustRange(CAFrameRateRange range) {
    CAFrameRateRange r = range;
    float maxFPS = (float)RAEDisplayMax();
    (void)maxFPS;
#if RAE_FPS_MODE == 1
    if (range.preferred > 0 && range.preferred < maxFPS) {
        r = CAFrameRateRangeMake(MIN(range.minimum, maxFPS), maxFPS, maxFPS);
    }
#elif RAE_FPS_MODE == 2
    if (maxFPS > 60 && (range.maximum == 0 || range.maximum > 60)) {
        float preferred = range.preferred > 0 ? MIN(range.preferred, 60.0f) : 60.0f;
        r = CAFrameRateRangeMake(MIN(range.minimum, 60.0f), 60, preferred);
    }
#endif
    if (gThermalCap > 0 && (r.maximum == 0 || r.maximum > gThermalCap)) {
        float cap = (float)gThermalCap;
        r = CAFrameRateRangeMake(MIN(r.minimum, cap), cap, MIN(r.preferred > 0 ? r.preferred : cap, cap));
    }
    return r;
}

%hook CADisplayLink

+ (CADisplayLink *)displayLinkWithTarget:(id)target selector:(SEL)selector {
    CADisplayLink *link = %orig;
    if (link) [gLinks addObject:link];
    return link;
}

- (void)setPreferredFramesPerSecond:(NSInteger)fps {
    objc_setAssociatedObject(self, &kRequestedFPS, @(fps), OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    %orig(RAEAdjustFPS(fps));
}

- (void)setPreferredFrameRateRange:(CAFrameRateRange)range {
    objc_setAssociatedObject(self, &kRequestedRange, [NSValue valueWithBytes:&range objCType:@encode(CAFrameRateRange)],
                             OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    %orig(RAEAdjustRange(range));
}

%end

#if RAE_HOOK_MTKVIEW
%hook MTKView

- (void)setPreferredFramesPerSecond:(NSInteger)fps {
    [gLinks addObject:self];
    objc_setAssociatedObject(self, &kRequestedFPS, @(fps), OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    %orig(RAEAdjustFPS(fps));
}

%end
#endif

// Re-applies the profile to everything that already exists (used when the thermal state changes).
static void RAERefreshFrameRates(void) {
    for (id object in gLinks.allObjects) {
        NSNumber *fps = objc_getAssociatedObject(object, &kRequestedFPS);
        if (fps) [object setPreferredFramesPerSecond:fps.integerValue];
        if ([object isKindOfClass:CADisplayLink.class]) {
            NSValue *value = objc_getAssociatedObject(object, &kRequestedRange);
            if (value) {
                CAFrameRateRange range;
                [value getValue:&range];
                [(CADisplayLink *)object setPreferredFrameRateRange:range];
            }
        }
    }
}

#pragma mark - Thermal guard

#if RAE_THERMAL_GUARD
// Only steps in when iOS says the phone is genuinely hot, so the system does not have to cut the frame rate harder.
static void RAEThermalChanged(void) {
    NSProcessInfoThermalState state = NSProcessInfo.processInfo.thermalState;
    NSInteger cap = 0;
    if (state >= NSProcessInfoThermalStateCritical) cap = 30;
    else if (state >= NSProcessInfoThermalStateSerious && RAEDisplayMax() > 60) cap = 60;
    if (cap != gThermalCap) {
        gThermalCap = cap;
        RAERefreshFrameRates();
    }
}
#endif

#pragma mark - Memory

#if RAE_MEMORY_TRIM
static dispatch_source_t gTrimTimer;

static void RAETrimMemory(void) {
    [NSURLCache.sharedURLCache removeAllCachedResponses];
    malloc_zone_pressure_relief(NULL, 0);
}

// While the app is in front, check now and then and trim only when the system is running low for this app.
static void RAEStartTrimTimer(void) {
    if (gTrimTimer) return;
    dispatch_source_t timer = dispatch_source_create(DISPATCH_SOURCE_TYPE_TIMER, 0, 0,
                                                     dispatch_get_global_queue(QOS_CLASS_UTILITY, 0));
    dispatch_source_set_timer(timer, dispatch_time(DISPATCH_TIME_NOW, 45 * NSEC_PER_SEC), 45 * NSEC_PER_SEC, 20 * NSEC_PER_SEC);
    dispatch_source_set_event_handler(timer, ^{
        size_t available = os_proc_available_memory();
        if (available > 0 && available < 300ull * 1024 * 1024) RAETrimMemory();
    });
    gTrimTimer = timer;
    dispatch_resume(timer);
}

static void RAEStopTrimTimer(void) {
    if (gTrimTimer) {
        dispatch_source_cancel(gTrimTimer);
        gTrimTimer = nil;
    }
}
#endif

#pragma mark - Timers

#if RAE_TIMER_SAVING
// Gives long repeating timers some slack so the system can run them together with other work.
static void RAEAddTolerance(NSTimer *timer, NSTimeInterval interval, BOOL repeats) {
    if (timer && repeats && interval >= 1.0 && timer.tolerance < interval * 0.1) timer.tolerance = interval * 0.1;
}

%hook NSTimer

+ (NSTimer *)scheduledTimerWithTimeInterval:(NSTimeInterval)interval target:(id)target selector:(SEL)selector
                                   userInfo:(id)userInfo repeats:(BOOL)repeats {
    NSTimer *timer = %orig;
    RAEAddTolerance(timer, interval, repeats);
    return timer;
}

+ (NSTimer *)scheduledTimerWithTimeInterval:(NSTimeInterval)interval repeats:(BOOL)repeats block:(void (^)(NSTimer *))block {
    NSTimer *timer = %orig;
    RAEAddTolerance(timer, interval, repeats);
    return timer;
}

%end
#endif

#pragma mark - Entry point

%ctor {
    @autoreleasepool {
        if (![NSBundle.mainBundle.bundleIdentifier isEqualToString:RAE_TARGET_BUNDLE]) return;
        gLinks = [NSHashTable weakObjectsHashTable];
        %init;

        NSNotificationCenter *center = NSNotificationCenter.defaultCenter;
        NSOperationQueue *main = NSOperationQueue.mainQueue;

#if RAE_THERMAL_GUARD
        [center addObserverForName:NSProcessInfoThermalStateDidChangeNotification object:nil queue:main
                        usingBlock:^(NSNotification *n) { RAEThermalChanged(); }];
        RAEThermalChanged();
#endif
#if RAE_MEMORY_TRIM
        [center addObserverForName:UIApplicationDidReceiveMemoryWarningNotification object:nil queue:main
                        usingBlock:^(NSNotification *n) { RAETrimMemory(); }];
        [center addObserverForName:UIApplicationDidBecomeActiveNotification object:nil queue:main
                        usingBlock:^(NSNotification *n) { RAEStartTrimTimer(); }];
        [center addObserverForName:UIApplicationWillResignActiveNotification object:nil queue:main
                        usingBlock:^(NSNotification *n) { RAEStopTrimTimer(); }];
#endif
#if RAE_MEMORY_TRIM || RAE_BACKGROUND_QUIET
        [center addObserverForName:UIApplicationDidEnterBackgroundNotification object:nil queue:main
                        usingBlock:^(NSNotification *n) {
#if RAE_MEMORY_TRIM
            RAETrimMemory();
#endif
#if RAE_BACKGROUND_QUIET
            // Ask the system to treat this app as low priority work while it is in the background.
            setpriority(PRIO_DARWIN_PROCESS, 0, PRIO_DARWIN_BG);
#endif
        }];
#endif
#if RAE_BACKGROUND_QUIET
        [center addObserverForName:UIApplicationWillEnterForegroundNotification object:nil queue:main
                        usingBlock:^(NSNotification *n) { setpriority(PRIO_DARWIN_PROCESS, 0, 0); }];
#endif
    }
}
