name: RAE Build

on:
  workflow_dispatch:
    inputs:
      project:
        description: Project folder name under projects/
        required: true

permissions:
  contents: write

jobs:
  build:
    runs-on: macos-14
    env:
      PROJECT: ${{ inputs.project }}
    steps:
      - name: Check the project name
        shell: bash
        run: |
          echo "$PROJECT" | grep -Eq '^[a-z0-9-]{1,80}$' || { echo "bad project name"; exit 1; }

      - name: Checkout
        uses: actions/checkout@v4

      - name: Install build tools
        shell: bash
        run: |
          brew install ldid dpkg
          echo "$(brew --prefix)/bin" >> "$GITHUB_PATH"

      - name: Install Theos and SDKs
        shell: bash
        run: |
          THEOS_DIR="${RUNNER_TEMP}/theos"
          git clone --recursive --depth=1 https://github.com/theos/theos.git "$THEOS_DIR"
          rm -rf "$THEOS_DIR/sdks"
          git clone --depth=1 https://github.com/theos/sdks.git "$THEOS_DIR/sdks"
          echo "THEOS=$THEOS_DIR" >> "$GITHUB_ENV"

      - name: Build rootless package
        shell: bash
        run: |
          cd "projects/$PROJECT"
          make clean || true
          make package FINALPACKAGE=1 THEOS_PACKAGE_SCHEME=rootless
          ls -la packages

      - name: Read version
        id: ver
        shell: bash
        run: echo "version=$(grep '^Version:' "projects/$PROJECT/control" | awk '{print $2}')" >> "$GITHUB_OUTPUT"

      - name: Publish release
        uses: softprops/action-gh-release@v2
        with:
          tag_name: ${{ inputs.project }}-v${{ steps.ver.outputs.version }}
          name: ${{ inputs.project }} ${{ steps.ver.outputs.version }}
          body: Generated by RAE. Rootless, arm64, iOS 15 and later.
          files: projects/${{ inputs.project }}/packages/*.deb
